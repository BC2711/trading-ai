# Trading AI production deployment template.
# Copy this file to .env and replace every placeholder before running production.

APP_NAME=Trading AI
ENVIRONMENT=production
API_PREFIX=/api
DOCS_ENABLED=false

# Public edge settings
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
TLS_CERT_PATH=./certs/fullchain.pem
TLS_KEY_PATH=./certs/privkey.pem
BACKUP_DIR=backups
ALLOWED_HOSTS=["your-domain.example","www.your-domain.example","localhost","127.0.0.1","backend","nginx"]
CORS_ORIGINS=["https://your-domain.example"]

# Backend security placeholders. Generate unique high-entropy values for production.
API_KEY=replace-with-long-random-api-key
JWT_SECRET=replace-with-long-random-jwt-secret
JWT_REFRESH_SECRET=replace-with-different-long-random-refresh-secret
CREDENTIAL_ENCRYPTION_SECRET=replace-with-long-random-encryption-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_THROTTLE_MAX_ATTEMPTS=5
LOGIN_THROTTLE_WINDOW_SECONDS=300
LOGIN_THROTTLE_LOCKOUT_SECONDS=300

# PostgreSQL container settings
POSTGRES_USER=trading
POSTGRES_PASSWORD=replace-with-long-random-postgres-password
POSTGRES_DB=trading

# Runtime service URLs inside Docker Compose
DATABASE_URL=postgresql+psycopg://trading:replace-with-long-random-postgres-password@postgres:5432/trading
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
DEVELOPMENT_AUTO_CREATE_SCHEMA=false
DEVELOPMENT_SCHEMA_REPAIR_ENABLED=false

# Frontend build-time public settings.
# Empty VITE_API_BASE_URL means same-origin API calls through Nginx.
VITE_API_BASE_URL=
VITE_API_KEY=replace-with-same-value-as-api-key-if-api-key-auth-is-enabled
VITE_SENTRY_DSN=

# Market data and AI provider settings
BINANCE_API_BASE_URL=https://api.binance.com
BINANCE_TESTNET_API_BASE_URL=https://testnet.binance.vision
BINANCE_BROKER_MODE=testnet
BINANCE_RECV_WINDOW=5000
MARKET_SYNC_SYMBOLS=["BTCUSDT","ETHUSDT"]
MARKET_SYNC_TIMEFRAME=15m
MARKET_SYNC_LIMIT=500
MARKET_SYNC_INTERVAL_MINUTES=5
MARKET_SYNC_REGENERATE_SIGNALS=true
AUTOMATED_TRADING_ENABLED=false
AUTOMATED_TRADING_EXECUTION_MODE=paper
AUTOMATED_TRADING_LIVE_ENABLED=false
AUTOMATED_TRADING_BROKER=binance
AUTOMATED_TRADING_MIN_CONFIDENCE=0.7
AUTOMATED_TRADING_MAX_ORDERS_PER_RUN=3
AUTOMATED_TRADING_ORDER_NOTIONAL_USD=100
AUTOMATED_TRADING_COOLDOWN_SECONDS=300
AUTOMATED_TRADING_INTERVAL_MINUTES=5
AUTOMATED_TRADING_MAX_SIGNAL_AGE_MINUTES=30
AUTOMATED_TRADING_ONE_POSITION_PER_SYMBOL=true
AUTOMATED_TRADING_REQUIRE_STRATEGY_ENABLED=true
AI_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-3.5-turbo
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3
LOCAL_MODEL_PATH=
AI_RETRAINING_SCHEDULER_ENABLED=false
AI_RETRAINING_CHECK_INTERVAL_MINUTES=60
AI_RETRAINING_BATCH_SIZE=5

# Sentiment providers. Missing keys automatically trigger fallback sentiment.
SENTIMENT_PROVIDERS=["newsapi","cryptopanic","reddit","x"]
SENTIMENT_REQUEST_TIMEOUT_SECONDS=8
SENTIMENT_ITEMS_PER_PROVIDER=10
NEWS_API_KEY=
NEWS_API_BASE_URL=https://newsapi.org/v2/everything
CRYPTOPANIC_API_KEY=
CRYPTOPANIC_BASE_URL=https://cryptopanic.com/api/v1/posts/
REDDIT_BEARER_TOKEN=
REDDIT_API_BASE_URL=https://www.reddit.com
REDDIT_SUBREDDIT=CryptoCurrency
REDDIT_USER_AGENT=trading-ai/0.1
X_BEARER_TOKEN=
X_RECENT_SEARCH_URL=https://api.x.com/2/tweets/search/recent

# Notification providers. Secrets stay server-side and are never returned to the frontend.
NOTIFICATION_REQUEST_TIMEOUT_SECONDS=8
NOTIFICATION_EMAIL_SMTP_HOST=
NOTIFICATION_EMAIL_SMTP_PORT=587
NOTIFICATION_EMAIL_USE_TLS=true
NOTIFICATION_EMAIL_USERNAME=
NOTIFICATION_EMAIL_PASSWORD=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=[]
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO_NUMBER=
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v20.0
DISCORD_WEBHOOK_URL=

# Observability and protection
ENABLE_METRICS=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=10
