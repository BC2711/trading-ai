APP_NAME=Trading AI
ENVIRONMENT=development
API_PREFIX=/api
DOCS_ENABLED=true
API_KEY=
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120
CREDENTIAL_ENCRYPTION_SECRET=change-me-in-production
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver","backend"]
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174"]
# DATABASE_URL=postgresql+psycopg2://trading:trading@localhost:5432/trading
DATABASE_URL=postgresql+psycopg2://postgres:erpteam%40probase@localhost:5432/trading
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
BINANCE_API_BASE_URL=https://api.binance.com
MARKET_SYNC_SYMBOLS=["BTCUSDT","ETHUSDT"]
MARKET_SYNC_TIMEFRAME=15m
MARKET_SYNC_LIMIT=500
MARKET_SYNC_INTERVAL_MINUTES=5
MARKET_SYNC_REGENERATE_SIGNALS=true
ENABLE_METRICS=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
AI_PROVIDER=rules
OPENAI_API_KEY=
