APP_NAME=Trading AI
ENVIRONMENT=development
API_PREFIX=/api
DOCS_ENABLED=true
API_KEY=
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-token-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_THROTTLE_MAX_ATTEMPTS=5
LOGIN_THROTTLE_WINDOW_SECONDS=300
LOGIN_THROTTLE_LOCKOUT_SECONDS=300
CREDENTIAL_ENCRYPTION_SECRET=change-me-in-production
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver","backend"]
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174"]
DATABASE_URL=postgresql+psycopg://trading:trading@localhost:5432/trading
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
DEVELOPMENT_AUTO_CREATE_SCHEMA=true
DEVELOPMENT_SCHEMA_REPAIR_ENABLED=true
BINANCE_API_BASE_URL=https://api.binance.com
MARKET_SYNC_SYMBOLS=["BTCUSDT","ETHUSDT"]
MARKET_SYNC_TIMEFRAME=15m
MARKET_SYNC_LIMIT=500
MARKET_SYNC_INTERVAL_MINUTES=5
MARKET_SYNC_REGENERATE_SIGNALS=true
ENABLE_METRICS=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
AI_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-3.5-turbo
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2
LOCAL_MODEL_PATH=
SENTIMENT_PROVIDERS=["newsapi","cryptopanic","reddit","x"]
SENTIMENT_REQUEST_TIMEOUT_SECONDS=8
SENTIMENT_ITEMS_PER_PROVIDER=10
NEWS_API_KEY=
NEWS_API_BASE_URL=https://newsapi.org/v2/everything
CRYPTOPANIC_API_KEY=
CRYPTOPANIC_BASE_URL=https://cryptopanic.com/api/v1/posts/
REDDIT_BEARER_TOKEN=
REDDIT_API_BASE_URL=https://www.reddit.com
REDDIT_SUBREDDIT=CryptoCurrency
REDDIT_USER_AGENT=trading-ai/0.1
X_BEARER_TOKEN=
X_RECENT_SEARCH_URL=https://api.x.com/2/tweets/search/recent
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=10
