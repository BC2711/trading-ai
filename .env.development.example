# Trading AI local development template.
# Copy to .env for Docker Compose development, or export the values you need locally.

APP_NAME=Trading AI
ENVIRONMENT=development
API_PREFIX=/api
DOCS_ENABLED=true

NGINX_HTTP_PORT=8080
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver","backend","nginx"]
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080"]

API_KEY=
JWT_SECRET=development-jwt-secret-change-for-shared-environments
JWT_REFRESH_SECRET=development-refresh-secret-change-for-shared-environments
CREDENTIAL_ENCRYPTION_SECRET=development-credential-secret-change-for-shared-environments
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

POSTGRES_USER=trading
POSTGRES_PASSWORD=trading
POSTGRES_DB=trading
DATABASE_URL=postgresql+psycopg://trading:trading@postgres:5432/trading
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
DEVELOPMENT_AUTO_CREATE_SCHEMA=true
DEVELOPMENT_SCHEMA_REPAIR_ENABLED=true

VITE_API_BASE_URL=http://localhost:8000
VITE_API_KEY=
VITE_SENTRY_DSN=

BINANCE_API_BASE_URL=https://api.binance.com
BINANCE_TESTNET_API_BASE_URL=https://testnet.binance.vision
BINANCE_BROKER_MODE=testnet
BINANCE_RECV_WINDOW=5000
MARKET_SYNC_SYMBOLS=["BTCUSDT","ETHUSDT"]
MARKET_SYNC_TIMEFRAME=15m
MARKET_SYNC_LIMIT=500
MARKET_SYNC_INTERVAL_MINUTES=5
MARKET_SYNC_REGENERATE_SIGNALS=true

AI_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-3.5-turbo
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
LOCAL_MODEL_PATH=
AI_RETRAINING_SCHEDULER_ENABLED=false

SENTIMENT_PROVIDERS=["newsapi","cryptopanic","reddit","x"]
NEWS_API_KEY=
CRYPTOPANIC_API_KEY=
REDDIT_BEARER_TOKEN=
X_BEARER_TOKEN=

NOTIFICATION_EMAIL_SMTP_HOST=
NOTIFICATION_EMAIL_SMTP_PORT=587
NOTIFICATION_EMAIL_USE_TLS=true
NOTIFICATION_EMAIL_USERNAME=
NOTIFICATION_EMAIL_PASSWORD=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=[]
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO_NUMBER=
DISCORD_WEBHOOK_URL=

ENABLE_METRICS=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
